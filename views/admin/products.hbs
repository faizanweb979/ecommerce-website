<div class="container my-5">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3 mb-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Admin Menu</h5>
                </div>
                <div class="list-group list-group-flush">
                    <a href="/admin/dashboard" class="list-group-item list-group-item-action">
                        <i class="fas fa-tachometer-alt me-2"></i> Dashboard
                    </a>
                    <a href="/admin/users" class="list-group-item list-group-item-action">
                        <i class="fas fa-users me-2"></i> Manage Users
                    </a>
                    <a href="/admin/products" class="list-group-item list-group-item-action active">
                        <i class="fas fa-box me-2"></i> Manage Products
                        {{#if pendingProductCount}}
                        <span class="badge bg-danger ms-1">{{pendingProductCount}}</span>
                        {{/if}}
                    </a>
                    <a href="/admin/orders" class="list-group-item list-group-item-action">
                        <i class="fas fa-shopping-cart me-2"></i> Manage Orders
                    </a>
                    <a href="/admin/blogs" class="list-group-item list-group-item-action">
                        <i class="fas fa-blog me-2"></i> Manage Blogs
                    </a>
                    <a href="/admin/feedbacks" class="list-group-item list-group-item-action">
                        <i class="fas fa-comments me-2"></i> Manage Feedbacks
                    </a>
                    <a href="/users/profile" class="list-group-item list-group-item-action">
                        <i class="fas fa-user me-2"></i> My Profile
                    </a>
                    <a href="/users/logout" class="list-group-item list-group-item-action text-danger">
                        <i class="fas fa-sign-out-alt me-2"></i> Logout
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="d-flex align-items-center gap-2">
                    <h2 class="mb-0">Manage Products</h2>
                    {{#if pendingProductCount}}
                    <span class="badge bg-warning text-dark fs-6">
                        <i class="fas fa-clock me-1"></i>{{pendingProductCount}} Pending
                    </span>
                    {{/if}}
                </div>
                <a href="/admin/products/add" class="btn btn-success">
                    <i class="fas fa-plus-circle me-2"></i> Add New Product
                </a>
            </div>

            {{#if formSuccess}}
            <div class="alert alert-success alert-dismissible fade show">
                {{formSuccess}}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            {{/if}}
            {{#if formError}}
            <div class="alert alert-danger alert-dismissible fade show">
                {{formError}}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            {{/if}}

            <!-- Approval Filter Tabs -->
            <ul class="nav nav-tabs mb-3">
                <li class="nav-item">
                    <a class="nav-link {{#if (eq currentApproval 'all')}}active{{/if}}" href="/admin/products">All</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{#if (eq currentApproval 'pending')}}active{{/if}}" href="/admin/products?approval=pending">
                        Pending
                        {{#if pendingProductCount}}<span class="badge bg-danger ms-1">{{pendingProductCount}}</span>{{/if}}
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{#if (eq currentApproval 'approved')}}active{{/if}}" href="/admin/products?approval=approved">Approved</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{#if (eq currentApproval 'rejected')}}active{{/if}}" href="/admin/products?approval=rejected">Rejected</a>
                </li>
            </ul>

            <div class="card">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Product List</h5>
                    <!-- Category filter -->
                    <div class="btn-group">
                        <a href="/admin/products{{#if currentApproval}}?approval={{currentApproval}}{{/if}}" class="btn btn-sm btn-outline-light {{#unless filter}}active{{/unless}}">All</a>
                        <a href="/admin/products?filter=men-clothing{{#if currentApproval}}&approval={{currentApproval}}{{/if}}" class="btn btn-sm btn-outline-light {{#if (eq filter 'men-clothing')}}active{{/if}}">Men's</a>
                        <a href="/admin/products?filter=women-clothing{{#if currentApproval}}&approval={{currentApproval}}{{/if}}" class="btn btn-sm btn-outline-light {{#if (eq filter 'women-clothing')}}active{{/if}}">Women's</a>
                        <a href="/admin/products?filter=electronics{{#if currentApproval}}&approval={{currentApproval}}{{/if}}" class="btn btn-sm btn-outline-light {{#if (eq filter 'electronics')}}active{{/if}}">Gadgets</a>
                        <a href="/admin/products?filter=accessories{{#if currentApproval}}&approval={{currentApproval}}{{/if}}" class="btn btn-sm btn-outline-light {{#if (eq filter 'accessories')}}active{{/if}}">Accessories</a>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th>Category</th>
                                    <th>Price</th>
                                    <th>Seller</th>
                                    <th>Approval</th>
                                    <th>Stock</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each products}}
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="{{this.imageUrl}}" alt="{{this.name}}" class="img-thumbnail me-2" style="width:50px;height:50px;object-fit:cover;">
                                            <div>
                                                <a href="/products/{{this._id}}" class="text-decoration-none">{{this.name}}</a>
                                                {{#if this.featured}}<span class="badge bg-warning ms-1">Featured</span>{{/if}}
                                                {{#if this.rejectionReason}}
                                                <br><small class="text-danger"><i class="fas fa-info-circle"></i> {{this.rejectionReason}}</small>
                                                {{/if}}
                                            </div>
                                        </div>
                                    </td>
                                    <td>{{categoryName this.category}}</td>
                                    <td>Rs. {{this.price}}</td>
                                    <td>
                                        {{#if this.seller}}{{this.seller.name}}
                                        {{else}}<span class="text-muted">N/A</span>{{/if}}
                                    </td>
                                    <td>
                                        {{#if (eq this.approvalStatus 'approved')}}
                                        <span class="badge bg-success">Approved</span>
                                        {{else if (eq this.approvalStatus 'rejected')}}
                                        <span class="badge bg-danger">Rejected</span>
                                        {{else}}
                                        <span class="badge bg-warning text-dark">Pending</span>
                                        {{/if}}
                                    </td>
                                    <td>
                                        <span class="badge {{#if this.inStock}}bg-success{{else}}bg-danger{{/if}}">
                                            {{#if this.inStock}}In Stock{{else}}Out of Stock{{/if}}
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex gap-1 justify-content-end flex-wrap">
                                            {{#unless (eq this.approvalStatus 'approved')}}
                                            <form action="/admin/products/{{this._id}}/approve" method="POST" style="display:inline">
                                                <button type="submit" class="btn btn-sm btn-success" title="Approve">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                            {{/unless}}

                                            {{#unless (eq this.approvalStatus 'rejected')}}
                                            <button type="button" class="btn btn-sm btn-warning" title="Reject"
                                                data-bs-toggle="modal" data-bs-target="#rejectModal{{this._id}}">
                                                <i class="fas fa-times"></i>
                                            </button>
                                            {{/unless}}

                                            <form action="/admin/products/featured/{{this._id}}" method="POST" style="display:inline">
                                                <button type="submit" class="btn btn-sm {{#if this.featured}}btn-warning{{else}}btn-outline-warning{{/if}}" title="Toggle Featured">
                                                    <i class="fas fa-star"></i>
                                                </button>
                                            </form>

                                            <a href="/admin/products/edit/{{this._id}}" class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            <button type="button" class="btn btn-sm btn-outline-danger" title="Delete"
                                                data-bs-toggle="modal" data-bs-target="#deleteModal{{this._id}}">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>

                                        <!-- Reject Modal -->
                                        <div class="modal fade" id="rejectModal{{this._id}}" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Reject Product</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <form action="/admin/products/{{this._id}}/reject" method="POST">
                                                        <div class="modal-body">
                                                            <p>Rejecting: <strong>{{this.name}}</strong></p>
                                                            <div class="mb-3">
                                                                <label class="form-label">Reason (optional)</label>
                                                                <textarea class="form-control" name="rejectionReason" rows="3"
                                                                    placeholder="e.g. Incomplete description, inappropriate content..."></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-danger">Reject Product</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Delete Modal -->
                                        <div class="modal fade" id="deleteModal{{this._id}}" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Confirm Delete</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        Are you sure you want to delete <strong>{{this.name}}</strong>?
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <form action="/admin/products/delete/{{this._id}}" method="POST">
                                                            <button type="submit" class="btn btn-danger">Delete</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                {{else}}
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">No products found</td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
