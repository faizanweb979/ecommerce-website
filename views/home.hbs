<!-- Hero Section -->
<section class="hero-section">
    <div id="carouselHero" class="carousel slide" data-bs-ride="false">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselHero" data-bs-slide-to="0" class="active"></button>
            <button type="button" data-bs-target="#carouselHero" data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#carouselHero" data-bs-slide-to="2"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="/images/new-slider/slider-03.jpg" class="d-block w-100" alt="Men's Fashion Collection">
                <div class="carousel-caption">
                    <h2>Men's Collection</h2>
                    <p>Discover our latest styles for men.</p>
                    <a href="/products?category=men-clothing" class="btn btn-hero-shop">Shop Now</a>
                </div>
            </div>
            <div class="carousel-item">
                <img src="/images/new-slider/slider-01.jpg" class="d-block w-100" alt="Women's Fashion Collection">
                <div class="carousel-caption">
                    <h2>Women's Collection</h2>
                    <p>Elegant and trendy styles for women.</p>
                    <a href="/products?category=women-clothing" class="btn btn-hero-shop">Shop Now</a>
                </div>
            </div>
            <div class="carousel-item">
                <img src="/images/new-slider/slider-04.png" class="d-block w-100" alt="Gadgets Collection">
                <div class="carousel-caption">
                    <h2>Gadgets</h2>
                    <p>Latest gadgets and electronics.</p>
                    <a href="/products?category=electronics" class="btn btn-hero-shop">Shop Now</a>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselHero" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselHero" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</section>


<!-- Categories Section -->
<section class="categories-section py-5">
    <div class="container">
        <!-- Section Header -->
        <div class="text-center mb-5">
            <h2 class="section-heading display-5 fw-bold mb-3">Shop By Category</h2>
            <p class="section-subtitle fs-5 text-muted">Discover our curated collections across multiple categories</p>
        </div>
        
        <!-- Categories Row -->
        <div class="row justify-content-center g-2 g-md-3">
            <!-- Men's Clothing -->
            <div class="col-auto">
                <div class="category-circle">
                    <a href="/products?category=men-clothing" class="text-decoration-none">
                        <div class="category-icon-circle" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('/images/men shirts/pexels-sumit-chahar-805247-3731202.jpg'); background-size: cover; background-position: center;">
                        </div>
                        <h4 class="category-text">Men's Clothing</h4>
                    </a>
                </div>
            </div>
            
            <!-- Women's Clothing -->
            <div class="col-auto">
                <div class="category-circle">
                    <a href="/products?category=women-clothing" class="text-decoration-none">
                        <div class="category-icon-circle" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('/images/women dress/pexels-dhanno-25184944.jpg'); background-size: cover; background-position: center;">
                        </div>
                        <h4 class="category-text">Women's Clothing</h4>
                    </a>
                </div>
            </div>
            
            <!-- Accessories -->
            <div class="col-auto">
                <div class="category-circle">
                    <a href="/products?category=accessories" class="text-decoration-none">
                        <div class="category-icon-circle" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('/images/women bags/pexels-ezz7-925402.jpg'); background-size: cover; background-position: center;">
                        </div>
                        <h4 class="category-text">Accessories</h4>
                    </a>
                </div>
            </div>
            
            <!-- Gadgets -->
            <div class="col-auto">
                <div class="category-circle">
                    <a href="/products?category=electronics" class="text-decoration-none">
                        <div class="category-icon-circle" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('/images/electronics/headphone 1.jpg'); background-size: cover; background-position: center;">
                        </div>
                        <h4 class="category-text">Gadgets</h4>
                    </a>
                </div>
            </div>
            
            <!-- Shoes -->
            <div class="col-auto">
                <div class="category-circle">
                    <a href="/products?category=shoes" class="text-decoration-none">
                        <div class="category-icon-circle" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('/images/men pents/pexels-alfaiz-virasat-633888-31039548.jpg'); background-size: cover; background-position: center;">
                        </div>
                        <h4 class="category-text">Shoes</h4>
                    </a>
                </div>
            </div>
            
            <!-- Watches -->
            <div class="col-auto">
                <div class="category-circle">
                    <a href="/products?category=watches" class="text-decoration-none">
                        <div class="category-icon-circle" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('/images/men watches/pexels-valon2000-2463012.jpg'); background-size: cover; background-position: center;">
                        </div>
                        <h4 class="category-text">Watches</h4>
                    </a>
                </div>
            </div>
        </div>
        
        <!-- View All Button -->
        <div class="text-center mt-5">
            <a href="/products" class="btn btn-primary btn-lg fw-semibold px-4 py-3 rounded-3">
                View All Categories
                <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>


{{#if user}}
<div class="container mt-4">
    {{#if successMessage}}
    <div class="alert alert-success">
        {{successMessage}}
    </div>
    {{/if}}
    
    {{#if (eq user.role 'admin')}}
    <div class="alert alert-primary d-flex align-items-center">
        <i class="fas fa-user-shield me-3 fs-4"></i>
        <div>
            <h5 class="alert-heading">Welcome, Admin!</h5>
            <p class="mb-0">You have full access to the e-commerce platform. Manage users, products, and monitor site activity from your <a href="/admin/dashboard" class="alert-link">admin dashboard</a>.</p>
        </div>
    </div>
    {{else if (eq user.role 'seller')}}
    <div class="alert alert-success d-flex align-items-center">
        <i class="fas fa-store me-3 fs-4"></i>
        <div>
            <h5 class="alert-heading">Welcome, Seller!</h5>
            <p class="mb-0">Ready to grow your business? Add and manage your products from your <a href="/seller/dashboard" class="alert-link">seller dashboard</a>.</p>
        </div>
    </div>
    {{else}}
    <div class="alert alert-info d-flex align-items-center">
        <i class="fas fa-user me-3 fs-4"></i>
        <div>
            <h5 class="alert-heading">Welcome back, {{user.name}}!</h5>
            <p class="mb-0">Check out our latest products and special offers below. Visit your <a href="/users/profile" class="alert-link">profile</a> to manage your account.</p>
        </div>
    </div>
    {{/if}}
</div>
{{/if}}

<div class="container">
    <!-- Featured Products Section -->
    <section class="my-5">
        <h2 class="section-heading display-5 fw-bold mb-3">Featured Products</h2>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            {{#each featuredProducts}}
            <div class="col">
                {{> product-card product=this}}
            </div>
            {{else}}
            <div class="col-12">
                <div class="alert alert-info">No featured products available at the moment.</div>
            </div>
            {{/each}}
        </div>
        <div class="text-center mt-4">
            <a href="/products" class="btn btn-outline-secondary">View All Products</a>
        </div>
    </section>
</div>

<!-- Save 60% Sale Countdown Section -->
<section class="sale-countdown-section my-5">
    <div class="sale-countdown-container">
        <div class="sale-countdown-overlay">
            <div class="sale-countdown-content">
                <p class="sale-subtitle">ONLY THIS MONTH</p>
                <h2 class="sale-title">SAVE 60% OFF SALE</h2>
                <div class="countdown-timer" id="countdown-timer">
                    <div class="countdown-item">
                        <span class="countdown-number" id="days">00</span>
                        <span class="countdown-label">Days</span>
                    </div>
                    <div class="countdown-separator">:</div>
                    <div class="countdown-item">
                        <span class="countdown-number" id="hours">00</span>
                        <span class="countdown-label">Hours</span>
                    </div>
                    <div class="countdown-separator">:</div>
                    <div class="countdown-item">
                        <span class="countdown-number" id="minutes">00</span>
                        <span class="countdown-label">Minutes</span>
                    </div>
                    <div class="countdown-separator">:</div>
                    <div class="countdown-item">
                        <span class="countdown-number" id="seconds">00</span>
                        <span class="countdown-label">Seconds</span>
                    </div>
                </div>
                <a href="/products" class="btn btn-sale-cta">Shop Now</a>
            </div>
        </div>
    </div>
</section>

