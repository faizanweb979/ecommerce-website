<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Forgot Password</h3>
                </div>
                <div class="card-body p-4">
                    {{#if formError}}
                    <div class="alert alert-danger">{{formError}}</div>
                    {{/if}}
                    {{#if formSuccess}}
                    <div class="alert alert-success">{{formSuccess}}</div>
                    {{/if}}

                    {{#unless formSuccess}}
                    <p class="text-muted mb-4">Enter your email address and we'll send you a link to reset your password.</p>
                    <form action="/users/forgot-password" method="POST">
                        <div class="mb-3">
                            <label for="email" class="form-label">Email Address</label>
                            <input type="email" class="form-control" id="email" name="email" required placeholder="Enter your registered email">
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>
                    </form>
                    {{/unless}}
                </div>
                <div class="card-footer bg-light text-center">
                    <a href="/users/login" class="text-decoration-none">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>
